# ============================================
# Development Environment Configuration
# ============================================
NODE_ENV=development
PORT=4000

DB_USER=erp_user
DB_PASSWORD=erp_dev_password
DB_NAME=erp_platform_dev
DATABASE_URL=postgresql://erp_user:erp_dev_password@localhost:5432/erp_platform_dev?schema=public

REDIS_PASSWORD=erp_dev_redis
REDIS_URL=redis://:erp_dev_redis@localhost:6379

JWT_SECRET=dev-jwt-secret-key-not-for-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:3000

THROTTLE_TTL=60000
THROTTLE_LIMIT=1000

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
