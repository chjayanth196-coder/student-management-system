# ============================================
# Multi-College ERP Platform - Environment Variables
# ============================================
# Copy this file to .env and adjust for your environment
# cp .env.example .env

# ---- Application ----
NODE_ENV=development
PORT=4000

# ---- Database (PostgreSQL) ----
DB_USER=erp_user
DB_PASSWORD=erp_secure_password
DB_NAME=erp_platform
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public

# ---- Redis ----
REDIS_PASSWORD=erp_redis_password
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379

# ---- JWT Authentication ----
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000,https://erp.example.com

# ---- Rate Limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
