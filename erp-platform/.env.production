# ============================================
# Production Environment Configuration
# ============================================
NODE_ENV=production
PORT=4000

# Use strong, unique passwords in production
DB_USER=erp_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=erp_platform
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Generate a strong random JWT secret (64+ chars)
JWT_SECRET=CHANGE_ME_64_CHAR_MIN_JWT_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://erp.example.com,https://*.erp.example.com

THROTTLE_TTL=60000
THROTTLE_LIMIT=60

NEXT_PUBLIC_API_URL=https://erp.example.com/api/v1
