# ============================================
# Staging Environment Configuration
# ============================================
NODE_ENV=staging
PORT=4000

DB_USER=erp_user
DB_PASSWORD=erp_staging_password_change_me
DB_NAME=erp_platform_staging
DATABASE_URL=postgresql://erp_user:erp_staging_password_change_me@postgres:5432/erp_platform_staging?schema=public

REDIS_PASSWORD=erp_staging_redis_change_me
REDIS_URL=redis://:erp_staging_redis_change_me@redis:6379

JWT_SECRET=staging-jwt-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https://staging.erp.example.com

THROTTLE_TTL=60000
THROTTLE_LIMIT=200

NEXT_PUBLIC_API_URL=https://staging.erp.example.com/api/v1
