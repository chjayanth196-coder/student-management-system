generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Institution {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  type              InstitutionType
  logo              String?
  address           String?
  city              String?
  state             String?
  country           String?
  phone             String?
  email             String?
  website           String?
  principal         String?
  academicYear      String?
  isActive          Boolean            @default(true)
  colors            Json?
  settings          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  academicYears     AcademicYear[]
  announcements     Announcement[]
  attendance        Attendance[]
  classes           Class[]
  departments       Department[]
  examSchedules     ExamSchedule[]
  feePayments       FeePayment[]
  feeStructure      FeeStructure[]
  hostelAllocations HostelAllocation[]
  hostelRooms       HostelRoom[]
  libraryBooks      LibraryBook[]
  notifications     Notification[]
  placements        Placement[]
  results           Result[]
  sections          Section[]
  staff             Staff[]
  subjects          Subject[]
  transportPasses   TransportPass[]
  transportRoutes   TransportRoute[]
  users             User[]

  @@map("institutions")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  name              String
  phone             String?
  gender            Gender?
  dob               DateTime?
  address           String?
  avatar            String?
  role              UserRole           @default(Student)
  isActive          Boolean            @default(true)
  isVerified        Boolean            @default(false)
  refreshToken      String?
  lastLogin         DateTime?
  otp               String?
  otpExpiry         DateTime?
  institutionId     String?
  rollNo            String?
  enrollmentNo      String?
  className         String?
  section           String?
  parentName        String?
  parentPhone       String?
  admissionYear     Int?
  semester          Int?
  employeeId        String?
  departmentId      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  plainPassword     String?
  attendanceRecords Attendance[]
  feePayments       FeePayment[]
  hostelAllocation  HostelAllocation[]
  notifications     Notification[]
  results           Result[]
  busPasses         TransportPass[]
  department        Department?        @relation(fields: [departmentId], references: [id])
  institution       Institution?       @relation(fields: [institutionId], references: [id])

  @@map("users")
}

model AcademicYear {
  id            String         @id @default(cuid())
  name          String
  startDate     DateTime
  endDate       DateTime
  isCurrent     Boolean        @default(false)
  status        String         @default("active")
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  classes       Class[]
  departments   Department[]
  examSchedules ExamSchedule[]
  results       Result[]
  subjects      Subject[]

  @@unique([institutionId, name])
  @@map("academic_years")
}

model Department {
  id             String       @id @default(cuid())
  name           String
  code           String
  description    String?
  hodName        String?
  status         String       @default("active")
  institutionId  String
  academicYearId String
  classes        Class[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  institution    Institution  @relation(fields: [institutionId], references: [id])
  staff          Staff[]
  subjects       Subject[]
  hod            User[]

  @@unique([institutionId, academicYearId, code])
  @@map("departments")
}

model Class {
  id              String         @id @default(cuid())
  className       String
  classCode       String
  semesterOrGrade String?
  capacity        Int?
  status          String         @default("active")
  institutionId   String
  academicYearId  String
  departmentId    String
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id])
  department      Department     @relation(fields: [departmentId], references: [id])
  institution     Institution    @relation(fields: [institutionId], references: [id])
  examSchedules   ExamSchedule[]
  results         Result[]
  sections        Section[]
  subjects        Subject[]

  @@unique([institutionId, academicYearId, departmentId, classCode])
  @@map("classes")
}

model Section {
  id            String      @id @default(cuid())
  sectionName   String
  roomNumber    String?
  capacity      Int?
  status        String      @default("active")
  institutionId String
  classId       String
  class         Class       @relation(fields: [classId], references: [id])
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, classId, sectionName])
  @@map("sections")
}

model Subject {
  id             String         @id @default(cuid())
  subjectName    String
  subjectCode    String
  credits        Int?
  description    String?
  status         String         @default("active")
  institutionId  String
  academicYearId String
  departmentId   String
  classId        String
  examSchedules  ExamSchedule[]
  results        Result[]
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  class          Class          @relation(fields: [classId], references: [id])
  department     Department     @relation(fields: [departmentId], references: [id])
  institution    Institution    @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, academicYearId, departmentId, classId, subjectCode])
  @@map("subjects")
}

model Staff {
  id                 String      @id @default(cuid())
  employeeId         String      @unique
  firstName          String
  lastName           String
  email              String
  phone              String?
  alternatePhone     String?
  gender             Gender?
  dob                DateTime?
  address            String?
  qualification      String?
  specialization     String?
  experience         Int?
  joiningDate        DateTime?
  designation        String?
  staffType          String
  photo              String?
  salary             Float?
  classTeacher       Boolean     @default(false)
  status             String      @default("active")
  deletedAt          DateTime?
  institutionId      String
  departmentId       String?
  assignedClassId    String?
  assignedSectionId  String?
  assignedSubjectIds String[]
  userId             String?
  createdBy          String?
  deletedBy          String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  department         Department? @relation(fields: [departmentId], references: [id])
  institution        Institution @relation(fields: [institutionId], references: [id])

  @@map("staff")
}

model Attendance {
  id            String      @id @default(cuid())
  date          DateTime
  status        String
  subject       String?
  remarks       String?
  markedBy      String
  institutionId String
  studentId     String
  classId       String?
  sectionId     String?
  subjectId     String?
  teacherId     String?
  institution   Institution @relation(fields: [institutionId], references: [id])
  student       User        @relation(fields: [studentId], references: [id])

  @@unique([institutionId, studentId, date, subjectId])
  @@index([institutionId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model Result {
  id             String        @id @default(cuid())
  examType       String
  term           String
  marksObtained  Float
  maxMarks       Float
  percentage     Float?
  grade          String?
  remarks        String?
  createdBy      String
  institutionId  String
  studentId      String
  subjectId      String?
  academicYearId String?
  classId        String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  class          Class?        @relation(fields: [classId], references: [id])
  institution    Institution   @relation(fields: [institutionId], references: [id])
  student        User          @relation(fields: [studentId], references: [id])
  subject        Subject?      @relation(fields: [subjectId], references: [id])

  @@unique([studentId, term, examType, subjectId])
  @@index([institutionId, studentId])
  @@index([institutionId, classId])
  @@index([institutionId, term])
  @@map("results")
}

model FeeStructure {
  id            String       @id @default(cuid())
  name          String
  category      String
  amount        Float
  frequency     String
  dueDay        Int?
  lateFee       Float?       @default(0)
  isOptional    Boolean      @default(false)
  description   String?
  isActive      Boolean      @default(true)
  institutionId String
  feePayments   FeePayment[]
  institution   Institution  @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, name])
  @@index([institutionId, category])
  @@map("fee_structures")
}

model FeePayment {
  id             String        @id @default(cuid())
  amount         Float
  paidAmount     Float
  dueDate        DateTime
  paidDate       DateTime?
  status         String
  paymentMode    String?
  transactionId  String?
  receiptNo      String?
  fine           Float?        @default(0)
  discount       Float?        @default(0)
  remarks        String?
  institutionId  String
  studentId      String
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  institution    Institution   @relation(fields: [institutionId], references: [id])
  student        User          @relation(fields: [studentId], references: [id])

  @@index([institutionId, studentId])
  @@index([institutionId, status])
  @@index([institutionId, dueDate])
  @@map("fee_payments")
}

model LibraryBook {
  id            String      @id @default(cuid())
  title         String
  author        String
  isbn          String?
  publisher     String?
  category      String?
  quantity      Int         @default(1)
  available     Int         @default(1)
  rackNo        String?
  description   String?
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@map("library_books")
}

model HostelRoom {
  id            String             @id @default(cuid())
  hostelName    String
  roomNo        String
  roomType      String
  capacity      Int
  occupied      Int                @default(0)
  rent          Float
  floor         Int?
  amenities     String?
  institutionId String
  allocations   HostelAllocation[]
  institution   Institution        @relation(fields: [institutionId], references: [id])

  @@unique([institutionId, hostelName, roomNo])
  @@map("hostel_rooms")
}

model HostelAllocation {
  id            String      @id @default(cuid())
  startDate     DateTime
  endDate       DateTime?
  status        String      @default("Active")
  roomId        String
  studentId     String
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  room          HostelRoom  @relation(fields: [roomId], references: [id])
  student       User        @relation(fields: [studentId], references: [id])

  @@unique([roomId, studentId, status])
  @@map("hostel_allocations")
}

model TransportRoute {
  id            String          @id @default(cuid())
  routeName     String
  startPoint    String
  endPoint      String
  busNo         String?
  driverName    String?
  driverPhone   String?
  pickupTime    String?
  dropTime      String?
  fee           Float?
  status        String          @default("Active")
  institutionId String
  busPasses     TransportPass[]
  institution   Institution     @relation(fields: [institutionId], references: [id])

  @@map("transport_routes")
}

model TransportPass {
  id            String         @id @default(cuid())
  startDate     DateTime
  endDate       DateTime
  status        String         @default("Active")
  fee           Float?
  routeId       String
  studentId     String
  institutionId String
  institution   Institution    @relation(fields: [institutionId], references: [id])
  route         TransportRoute @relation(fields: [routeId], references: [id])
  student       User           @relation(fields: [studentId], references: [id])

  @@map("transport_passes")
}

model Placement {
  id            String      @id @default(cuid())
  companyName   String
  jobTitle      String?
  description   String?
  package       Float?
  location      String?
  lastDate      DateTime?
  eligibility   String?
  status        String      @default("Open")
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@map("placements")
}

model Notification {
  id            String       @id @default(cuid())
  title         String
  message       String
  type          String       @default("info")
  isRead        Boolean      @default(false)
  entity        String?
  entityId      String?
  userId        String
  institutionId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution? @relation(fields: [institutionId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([institutionId, createdAt])
  @@map("notifications")
}

model Announcement {
  id            String      @id @default(cuid())
  title         String
  content       String
  priority      String      @default("normal")
  targetRole    String?
  isActive      Boolean     @default(true)
  createdBy     String
  institutionId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  institution   Institution @relation(fields: [institutionId], references: [id])

  @@index([institutionId, isActive])
  @@map("announcements")
}

model ExamSchedule {
  id             String       @id @default(cuid())
  examName       String
  examType       String
  term           String
  subjectId      String
  date           DateTime
  startTime      String
  endTime        String
  roomNumber     String?
  maxMarks       Int
  description    String?
  institutionId  String
  classId        String
  academicYearId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  class          Class        @relation(fields: [classId], references: [id])
  institution    Institution  @relation(fields: [institutionId], references: [id])
  subject        Subject      @relation(fields: [subjectId], references: [id])

  @@unique([institutionId, subjectId, examType, term])
  @@map("exam_schedules")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum InstitutionType {
  School
  College
  University
  Other
}

enum UserRole {
  SuperAdmin
  CollegeAdmin
  Principal
  VicePrincipal
  HOD
  Faculty
  LabFaculty
  Accountant
  Librarian
  HostelWarden
  TransportManager
  PlacementOfficer
  Parent
  Student
  Alumni
  Guest
}

enum Gender {
  Male
  Female
  Other
}
