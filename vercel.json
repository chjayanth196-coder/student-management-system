{
  "version": 2,
  "builds": [
    {
      "src": "student-management-system/client/package.json",
      "use": "@vercel/node",
      "config": {
        "installCommand": "npm install",
        "buildCommand": "npm run build",
        "outputDirectory": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "student-management-system/client/$1"
    }
  ]
}
